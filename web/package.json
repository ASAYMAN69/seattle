{
  "name": "seattle-transit-equity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Seattle Transit Equity Index — Vite + TypeScript + MapLibre GL SPA",
  "scripts": {
    "dev": "vite",
    "dev:mock": "npm run dev:mock:gen && node scripts/dev-api.mjs & vite",
    "dev:mock:api": "node scripts/dev-api.mjs",
    "dev:mock:gen": "python3 scripts/gen-dev-mock.py",
    "start": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
